[gd_scene format=3]

[node name="EnterpriseView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="VBoxContainer" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title-label" type="Label" parent="Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Restaurante Sabor da Praca | Nível 1 de 5"

[node name="Summary-label" type="Label" parent="Margin/VBoxContainer"]
layout_mode = 2
text = "Dinheiro: R$ 0,00 | Receita diária: R$ 0,00 | Despesas: R$ 0,00 | Lucro estimado: R$ 0,00 | Capacidade: 0 (teto de receita R$ 0,00)"
autowrap_mode = 2

[node name="Status-label" type="Label" parent="Margin/VBoxContainer"]
layout_mode = 2
text = "Operando normalmente | Contas pendentes: 0 (0 em atraso) | Folha semanal: R$ 0,00 | Lucro acumulado: R$ 0,00"
autowrap_mode = 2

[node name="Sections" type="HBoxContainer" parent="Margin/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 18

[node name="Business-panel" type="PanelContainer" parent="Margin/VBoxContainer/Sections"]
